ARankAdventurerEmblem: {
	DisplayName: Эмблема авантюриста (ранг A)
	Tooltip: Жители дают вам скидку 20%
}

BRankAdventurerEmblem: {
	DisplayName: Эмблема авантюриста (ранг B)
	Tooltip: Жители дают вам скидку 13%
}

CRankAdventurerEmblem: {
	DisplayName: Эмблема авантюриста (ранг C)
	Tooltip: Жители дают вам скидку 8%
}

FRankAdventurerEmblem: {
	DisplayName: Эмблема авантюриста (ранг F)
	Tooltip: Жители дают вам скидку 5%
}

StarterBag: {
	DisplayName: Стартовый мешок
	Tooltip:
		'''
		Даёт начинающим авантюристам всё необходимое для старта
		Не потеряйте его: он у вас один
		'''
}

CookEnchantment: {
	DisplayName: Зачарование повара
	Tooltip:
		'''
		Вы больше не испытываете голода
		Вы получаете бафф «Сытость»
		Вместе с атакой может вылететь пара ингредиентов для торта
		Регенерация здоровья увеличена на 1
		'''
}

